# ── 데이터베이스 ───────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 Postgres
# 운영: Supabase 서울 리전의 pooled 엔드포인트를 쓴다 (direct 아님)
DATABASE_URI=postgres://ayuta:ayuta@127.0.0.1:55432/ayuta

# ── Supabase ─────────────────────────────────────────────────
# 프로젝트 ref · 리전: nhlqgzhlizgryfmrdbme · ap-northeast-2 (클라이언트 AYUTA 조직)
# CLI 는 전역 로그인을 바꾸지 않고 이 토큰으로만 쓴다. `supabase link` 는 api-keys 조회 권한이
# 없어 실패하지만 DB 연결에는 필요 없다
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# 비밀번호는 퍼센트 인코딩해서 넣는다
# 앱(Vercel)용 — transaction pooler 6543
SUPABASE_DATABASE_URI=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
# 스키마 반영·마이그레이션용 — session pooler 5432 (transaction 모드는 DDL·prepared statement 에 부적합)
SUPABASE_DIRECT_URI=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# ── Payload ───────────────────────────────────────────────────
# 32바이트 이상 무작위 문자열. openssl rand -base64 32
PAYLOAD_SECRET=

# ── 사이트 ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 결제 (PortOne V2) ─────────────────────────────────────────
# 대표님 도메인 수령 후 발급. 채널키를 바꾸면 PG사가 바뀐다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# ── 번역 (2차 범위) ───────────────────────────────────────────
# Free API는 입력 텍스트를 저장한다. 반드시 Pro 키를 쓴다
DEEPL_API_KEY=

# ── 메일 ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── 검색 (Q27) ────────────────────────────────────────────────
# 네이버 서치어드바이저 소유확인 토큰. 도메인 연결 후 발급받아 넣는다(비우면 메타 태그를 내지 않는다)
# canonical·hreflang·sitemap·robots 의 기준 주소는 위 NEXT_PUBLIC_SITE_URL — 도메인을 받으면 그 값만 바꾼다
NAVER_SITE_VERIFICATION=

# 운영 DB 인증서 검증(큐 Q31). Supabase 루트 인증서 PEM 전체를 넣는다 — 저장소 certs/supabase-root-2021-ca.pem 과 같은 값.
# 비워 두면 인증서 검증 없이 연결 문자열 그대로 접속한다(로컬 docker·CI).
# 한 줄로 넣어야 하면 줄바꿈을 \n 으로 적어도 된다.
DATABASE_CA_CERT=
# 로컬에서 운영 DB 에 스크립트를 돌릴 때 개발 모드 자동 스키마 반영(push)을 끈다
# PAYLOAD_DB_PUSH=false
